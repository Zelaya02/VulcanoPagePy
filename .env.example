# Copia este archivo a ".env" y ajusta los valores

# URL de conexión completa (tiene prioridad sobre las variables PG*)
DATABASE_URL=postgresql://vulcano:vulcano@localhost:5432/vulcano

# Alternativa (si no usas DATABASE_URL):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=vulcano
# PGPASSWORD=vulcano
# PGDATABASE=vulcano

# Secreto de sesión de Flask (cámbialo en producción)
FLASK_SECRET=cambia-esto-por-un-valor-seguro

# 1 para modo desarrollo con recarga automática
FLASK_DEBUG=1

# Puerto del servidor
PORT=5000
